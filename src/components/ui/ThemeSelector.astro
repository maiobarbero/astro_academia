---
import { template } from '../../settings.ts'
---

<label
  class="inline-flex shrink-0 cursor-pointer items-center gap-0.5 rounded-full border border-base-300 bg-base-200 p-0.5 text-base-content transition-colors hover:border-base-content/40 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-base-content"
  title="Switch between light and dark themes"
>
  <input
    type="checkbox"
    value={template.darkTheme}
    class="peer sr-only"
    role="switch"
    data-theme-toggle
    aria-label="Dark mode"
  />
  <span class="flex size-8 items-center justify-center rounded-full bg-base-100 shadow-sm transition-colors peer-checked:bg-transparent peer-checked:text-base-content/70 peer-checked:shadow-none" aria-hidden="true">
    <svg
      class="size-4"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round">
      <circle cx="12" cy="12" r="5" />
      <path
        d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
    </svg>
  </span>
  <span class="flex size-8 items-center justify-center rounded-full text-base-content/70 transition-colors peer-checked:bg-base-100 peer-checked:text-base-content peer-checked:shadow-sm" aria-hidden="true">
    <svg
      class="size-4"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</label>
