---
import {template} from '@/settings'
interface Props {
	title: string
	description: string
	image: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const { title, description, image } = Astro.props
---

<meta charset='utf-8' />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<link
	rel='icon'
	type='image/svg+xml'
	href='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>'
/>
<meta name='generator' content={Astro.generator} />

<!-- Sitemap -->
<link rel="sitemap" href={`${template.base}/sitemap-index.xml`} />

<!-- Canonical URL -->
<link rel='canonical' href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />

<!-- Open Graph / Facebook -->
<meta property='og:type' content='website' />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={Astro.url} />
<meta property='twitter:title' content={title} />
<meta property='twitter:description' content={description} />
<meta property='twitter:image' content={new URL(image, Astro.url)} />

<!-- Restore the configured theme before the page paints. -->
<script is:inline define:vars={{ lightTheme: template.lightTheme, darkTheme: template.darkTheme }}>
  try {
    const savedTheme = localStorage.getItem('theme');
    document.documentElement.dataset.theme =
      savedTheme === lightTheme || savedTheme === darkTheme ? savedTheme : lightTheme;
  } catch {
    document.documentElement.dataset.theme = lightTheme;
  }
</script>
<script>
  import { template } from '@/settings'

  const { lightTheme, darkTheme } = template

  function currentTheme() {
    const theme = document.documentElement.dataset.theme
    return theme === darkTheme ? darkTheme : lightTheme
  }

  function syncControls() {
    document.querySelectorAll<HTMLInputElement>('[data-theme-toggle]').forEach((input) => {
      input.checked = currentTheme() === darkTheme
    })
  }

  document.addEventListener('change', (event) => {
    const input = event.target
    if (!(input instanceof HTMLInputElement) || !input.matches('[data-theme-toggle]')) return

    const theme = input.checked ? darkTheme : lightTheme
    document.documentElement.dataset.theme = theme
    syncControls()

    try {
      localStorage.setItem('theme', theme)
    } catch {
      // Keep switching usable when browser storage is unavailable.
    }
  })

  // Carry the active theme into the next page before Astro replaces the DOM.
  document.addEventListener('astro:before-swap', (event) => {
    event.newDocument.documentElement.dataset.theme = currentTheme()
  })
  document.addEventListener('astro:page-load', syncControls)
  syncControls()
</script>
